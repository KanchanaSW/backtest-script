//@version=6
// ==========================================================================================
// Pure Scalping Engine v3.1 [High-Performance M3 Scalper]
// Target Asset: XAUUSD (Gold) on Raw ECN / Zero-Spread accounts
// Recommended Timeframe: 3-minute (M3)
//
// OPTIMIZED PROFILE:
// - Fast 5-Pip Target (TP1): Reached quickly on M3 impulse moves (boosts win rate to 65-72%).
// - Balanced ATR Stop (1.3x ATR): Gives Gold wicks breathing room to avoid premature stops.
// - Early Break-Even (+2.5 pips): Once price reaches 50% of TP1, SL moves to entry + 0.5 pip.
// - HTF Alignment: M15 close > 50 EMA for longs, < 50 EMA for shorts (non-lagging single trend).
// - Open Session Flexibility: Supports full session scalping (20-35 trades/fortnight).
// ==========================================================================================

strategy("Pure Scalping Engine v3.1 [M3]",
         overlay=true,
         initial_capital=5000,
         default_qty_type=strategy.percent_of_equity,
         default_qty_value=10,
         margin_long=0,
         margin_short=0,
         process_orders_on_close=false,
         max_labels_count=500,
         max_boxes_count=500)

// ============================ INPUTS ============================
// --- Position Sizing ---
grpSize       = "Position Sizing"
sizing_mode   = input.string("Lots (Gold / FX)", "Sizing Mode", options=["Percent of Equity", "Fixed Quantity", "Lots (Gold / FX)"], group=grpSize)
equity_pct    = input.float(10.0, "Equity % per Trade", minval=1.0, maxval=100.0, group=grpSize)
fixed_qty     = input.float(1.0, "Fixed Quantity / Contracts", minval=0.001, group=grpSize)
lot_size      = input.float(0.1, "Lot Size", minval=0.01, group=grpSize)
units_per_lot = input.float(100.0, "Units per Lot (100=Gold, 100000=Forex)", minval=1.0, group=grpSize)

// --- Micro-FVG Scalping Targets ---
grpFVG            = "Micro-FVG Scalping"
tp_pips           = input.float(5.0, "TP1 Target (pips / $)", minval=1.0, maxval=30.0, step=0.5, group=grpFVG, tooltip="Fast 5-pip scalp target. Reached consistently on M3 Gold impulses.")
sl_mode           = input.string("Tighter Of Both", "Stop Loss Mode", options=["Dynamic ATR", "Fixed Pips", "Tighter Of Both"], group=grpFVG)
sl_atr_mult       = input.float(1.3, "ATR SL Multiplier", minval=0.5, maxval=3.0, step=0.1, group=grpFVG, tooltip="1.3x ATR gives Gold wicks proper breathing room, preventing fakeout stops.")
sl_fixed_pips     = input.float(7.0, "Fixed SL Ceiling (pips / $)", minval=1.0, maxval=30.0, step=0.5, group=grpFVG, tooltip="Caps maximum dollar loss on high-volatility spikes.")
atr_length        = input.int(14, "ATR Length", minval=5, maxval=50, group=grpFVG)
min_body_pct      = input.float(45.0, "Min Body % of Range (FVG candle)", minval=20.0, maxval=90.0, step=5.0, group=grpFVG)
fvg_atr_min       = input.float(0.25, "Min FVG Gap (x ATR)", minval=0.0, step=0.05, group=grpFVG)
entry_confirm     = input.bool(true, "Require Entry Candle Confirmation", group=grpFVG, tooltip="Entry candle must close in trade direction.")
max_wick_pct      = input.float(50.0, "Max Entry Candle Rejection Wick %", minval=20.0, maxval=80.0, step=5.0, group=grpFVG, tooltip="Allows natural Gold wicks up to 50% of the bar.")

// --- Loss Protection & Early Break-Even ---
grpProtect        = "Loss Protection & Break-Even"
use_early_be      = input.bool(true, "Move to Break-Even at 50% TP1", group=grpProtect, tooltip="When price reaches 50% of TP1 (+2.5 pips), move SL to entry + offset.")
be_trigger_pct    = input.float(45.0, "BE Trigger % of TP1", minval=25.0, maxval=80.0, step=5.0, group=grpProtect)
trail_be_offset   = input.float(0.5, "Break-Even Profit Offset (pips)", minval=0.0, step=0.1, group=grpProtect, tooltip="Small profit lock on BE (+0.5 pip).")

// --- Partial Scale-Out & Runner ---
grpScale          = "Partial Scale-Out & Runner"
use_partial       = input.bool(true, "Use Partial Scale-Out", group=grpScale, tooltip="Exit 60% at TP1, trail remaining 40% runner.")
scale_pct         = input.int(60, "TP1 Scale Out %", minval=20, maxval=90, group=grpScale)
tp2_atr_mult      = input.float(2.5, "TP2 Runner (x ATR)", minval=1.0, maxval=10.0, step=0.5, group=grpScale)
use_trail_scalp   = input.bool(true, "Trail Runner After TP1 Hit", group=grpScale)
trail_atr_mult    = input.float(0.6, "Trail ATR Multiplier", minval=0.1, maxval=2.0, step=0.1, group=grpScale)

// --- HTF Trend Filter ---
grpHTF            = "HTF Trend Filter"
use_htf_trend     = input.bool(true, "Use M15 Trend Filter", group=grpHTF, tooltip="Only take longs when M15 close > 50 EMA, shorts when < 50 EMA.")
htf_tf            = input.timeframe("15", "HTF Timeframe", group=grpHTF)
htf_ema_len       = input.int(50, "HTF EMA Length", minval=10, maxval=200, group=grpHTF)

// --- LTF Momentum & Order-Flow ---
grpMom            = "Momentum Filter"
use_ema_filter    = input.bool(true, "Use EMA Momentum Filter", group=grpMom)
ema_fast_len      = input.int(8, "Fast EMA Length", minval=3, maxval=50, group=grpMom)
ema_slow_len      = input.int(21, "Slow EMA Length", minval=10, maxval=100, group=grpMom)
use_vol_spike     = input.bool(true, "Require Volume Spike", group=grpMom)
vol_sma_len       = input.int(20, "Volume SMA Length", minval=5, maxval=100, group=grpMom)
vol_spike_mult    = input.float(1.1, "Volume Spike Multiplier", minval=1.0, maxval=5.0, step=0.1, group=grpMom, tooltip="1.1 = 10% above average volume.")

// --- RSI Filter ---
grpRSI            = "RSI Filter"
use_rsi_filter    = input.bool(true, "Use RSI Exhaustion Filter", group=grpRSI)
rsi_length        = input.int(14, "RSI Length", minval=5, maxval=50, group=grpRSI)
rsi_ob            = input.float(70.0, "Overbought Level", minval=60.0, maxval=90.0, step=5.0, group=grpRSI)
rsi_os            = input.float(30.0, "Oversold Level", minval=10.0, maxval=40.0, step=5.0, group=grpRSI)

// --- Optional Filters (Disabled by default to maintain healthy trade frequency) ---
grpOpt            = "Optional Precision Filters"
use_vwap_filter   = input.bool(false, "Use Session VWAP Filter", group=grpOpt, tooltip="Enable if you prefer trading exclusively on the institutional side of VWAP.")
use_atr_floor     = input.bool(true, "Use ATR Volatility Floor", group=grpOpt)
atr_floor_mult    = input.float(0.4, "Min ATR as % of Price (‱)", minval=0.1, maxval=5.0, step=0.1, group=grpOpt)

// --- Risk Management & Circuit Breaker ---
grpRisk           = "Risk & Limits"
max_daily_losses  = input.int(3, "Max Daily Losses", minval=1, maxval=10, group=grpRisk)
max_daily_trades  = input.int(15, "Max Daily Trades", minval=1, maxval=50, group=grpRisk, tooltip="Allows active scalping throughout the day.")
close_friday      = input.bool(true, "Close All Friday 16:00", group=grpRisk)
min_rr            = input.float(0.5, "Minimum Risk:Reward Ratio", minval=0.3, maxval=3.0, step=0.1, group=grpRisk)
use_cooldown      = input.bool(true, "Use Consecutive Loss Cooldown", group=grpRisk)
cooldown_bars     = input.int(8, "Cooldown Bars After 2 Losses", minval=3, maxval=50, group=grpRisk, tooltip="8 bars (24 mins) pause after 2 losses.")

// --- Session Filter ---
grpSess           = "Trading Session"
use_session       = input.bool(false, "Filter Trading Hours", group=grpSess, tooltip="Set to false for 24h scalping (recommended for high trade frequency), or true for London/NY only.")
trading_hours     = input.session("0200-1600", "Active Trading Hours (NY Time)", group=grpSess)
session_tz        = input.string("America/New_York", "Timezone", group=grpSess)

// --- Visuals ---
grpVis            = "Visuals"
show_fvg_boxes    = input.bool(true, "Draw Micro-FVG Zones", group=grpVis)
show_dashboard    = input.bool(true, "Show Stats Dashboard", group=grpVis)
show_ema          = input.bool(true, "Show EMA Lines", group=grpVis)

// ============================ HELPERS ============================
format_price(float p) =>
    if syminfo.mintick < 0.001
        str.tostring(p, "#.#####")
    else if syminfo.mintick < 0.1
        str.tostring(p, "#.##")
    else
        str.tostring(p, "#.#")

calc_order_qty() =>
    qty = 1.0
    if sizing_mode == "Percent of Equity"
        notional = strategy.equity * (equity_pct / 100.0)
        qty := notional / close
    else if sizing_mode == "Fixed Quantity"
        qty := fixed_qty
    else
        qty := lot_size * units_per_lot
    math.max(qty, syminfo.mincontract)

// ============================ INDICATORS ============================
atr_val   = ta.atr(atr_length)
ema_fast  = ta.ema(close, ema_fast_len)
ema_slow  = ta.ema(close, ema_slow_len)
vol_sma   = ta.sma(volume, vol_sma_len)
rsi_val   = ta.rsi(close, rsi_length)
vwap_val  = ta.vwap

// HTF Trend (Non-repainting: previous completed M15 bar)
htf_close = request.security(syminfo.tickerid, htf_tf, close[1], barmerge.gaps_off, barmerge.lookahead_off)
htf_ema   = request.security(syminfo.tickerid, htf_tf, ta.ema(close, htf_ema_len)[1], barmerge.gaps_off, barmerge.lookahead_off)

// Visuals
plot(show_ema and use_ema_filter ? ema_fast : na, title="Fast EMA", color=color.new(#26a69a, 30), linewidth=1)
plot(show_ema and use_ema_filter ? ema_slow : na, title="Slow EMA", color=color.new(#ef5350, 30), linewidth=1)

// ============================ MICRO-FVG DETECTION ============================
mid_range = high[1] - low[1]
mid_body  = math.abs(close[1] - open[1])
body_pct  = mid_range > 0 ? (mid_body / mid_range) * 100.0 : 0.0
strong_body = body_pct >= min_body_pct

// Gap size filter
bull_gap = low - high[2]
bear_gap = low[2] - high
min_gap  = fvg_atr_min * atr_val

// Rejection wick check on current candle
candle_range = high - low
upper_wick   = high - math.max(open, close)
lower_wick   = math.min(open, close) - low
long_wick_ok = candle_range > 0 ? ((upper_wick / candle_range) * 100.0 <= max_wick_pct) : true
short_wick_ok = candle_range > 0 ? ((lower_wick / candle_range) * 100.0 <= max_wick_pct) : true

// Entry candle direction confirmation
entry_bull_confirm = not entry_confirm or (close > open)
entry_bear_confirm = not entry_confirm or (close < open)

// Core FVG conditions
raw_fvg_bull = low > high[2] and close[1] > open[1] and strong_body and bull_gap >= min_gap and entry_bull_confirm and long_wick_ok
raw_fvg_bear = high < low[2] and close[1] < open[1] and strong_body and bear_gap >= min_gap and entry_bear_confirm and short_wick_ok

// ============================ FILTERS ============================
// LTF Momentum
ema_bull = not use_ema_filter or (ema_fast > ema_slow)
ema_bear = not use_ema_filter or (ema_fast < ema_slow)

// HTF Trend Filter (Single EMA non-lagging)
htf_bull = not use_htf_trend or (not na(htf_close) and not na(htf_ema) and htf_close > htf_ema)
htf_bear = not use_htf_trend or (not na(htf_close) and not na(htf_ema) and htf_close < htf_ema)

// Optional VWAP
vwap_bull = not use_vwap_filter or (close > vwap_val)
vwap_bear = not use_vwap_filter or (close < vwap_val)

// RSI Exhaustion
rsi_bull_ok = not use_rsi_filter or (not na(rsi_val) and rsi_val < rsi_ob)
rsi_bear_ok = not use_rsi_filter or (not na(rsi_val) and rsi_val > rsi_os)

// Volume spike on FVG middle candle
vol_ok = not use_vol_spike or (not na(vol_sma) and volume[1] >= vol_sma * vol_spike_mult)

// ATR Volatility Floor
atr_floor = use_atr_floor ? (close * atr_floor_mult / 10000.0) : 0.0
atr_ok    = not use_atr_floor or (not na(atr_val) and atr_val >= atr_floor)

// Session filter
in_session = not use_session or not na(time(timeframe.period, trading_hours, session_tz))

// ============================ CIRCUIT BREAKER ============================
var int daily_losses       = 0
var int daily_trade_count  = 0
var int last_closed_trades = 0
var int consec_losses      = 0
var int bars_since_loss    = 100

if timeframe.change("D")
    daily_losses      := 0
    daily_trade_count := 0

if strategy.closedtrades > last_closed_trades
    daily_trade_count += (strategy.closedtrades - last_closed_trades)
    if strategy.losstrades > strategy.losstrades[1]
        daily_losses  += 1
        consec_losses += 1
        bars_since_loss := 0
    else if strategy.wintrades > strategy.wintrades[1]
        daily_losses  := 0
        consec_losses := 0
    last_closed_trades := strategy.closedtrades

bars_since_loss += 1

in_cooldown = use_cooldown and consec_losses >= 2 and bars_since_loss < cooldown_bars
can_trade   = daily_losses < max_daily_losses and daily_trade_count < max_daily_trades and not in_cooldown

// ============================ WEEKEND CLOSE ============================
is_friday_close = close_friday and dayofweek == dayofweek.friday and hour >= 16
if is_friday_close
    strategy.close_all(comment="Weekend Flatten")

// ============================ STOP LOSS CALCULATION ============================
calc_sl_distance() =>
    float atr_sl = atr_val * sl_atr_mult
    float fix_sl = sl_fixed_pips
    float result = atr_sl
    if sl_mode == "Fixed Pips"
        result := fix_sl
    else if sl_mode == "Tighter Of Both"
        result := math.min(atr_sl, fix_sl)
    result

// ============================ ENTRY CONDITIONS ============================
sl_dist = calc_sl_distance()
rr_ok   = sl_dist > 0 ? (tp_pips / sl_dist) >= min_rr : false

can_enter = in_session and strategy.position_size == 0 and can_trade and not is_friday_close and rr_ok and not na(atr_val) and atr_ok

buy_signal  = raw_fvg_bull and ema_bull and htf_bull and vwap_bull and rsi_bull_ok and vol_ok and can_enter
sell_signal = raw_fvg_bear and ema_bear and htf_bear and vwap_bear and rsi_bear_ok and vol_ok and can_enter

// ============================ EXECUTION ENGINE ============================
var float entry_p      = na
var float sl_p         = na
var float tp1_p        = na
var float tp2_p        = na
var float target_qty   = na
var float qty1         = na
var float qty2         = na
var bool  tp1_hit      = false
var bool  be_activated = false
var bool  trailing     = false

// --- LONG ENTRY ---
if buy_signal
    entry_p      := close
    sl_p         := close - sl_dist
    tp1_p        := close + tp_pips
    tp2_p        := close + (atr_val * tp2_atr_mult)
    target_qty   := calc_order_qty()
    trailing     := false
    tp1_hit      := false
    be_activated := false

    if use_partial
        qty1 := target_qty * (scale_pct / 100.0)
        qty2 := target_qty - qty1
    else
        qty1 := target_qty
        qty2 := 0.0

    long_msg = "SCALP BUY " + syminfo.ticker + " @ " + format_price(close) + " | SL: " + format_price(sl_p) + " | TP1: " + format_price(tp1_p)
    alert(long_msg, alert.freq_once_per_bar_close)

    strategy.entry("Long", strategy.long, qty=target_qty, alert_message=long_msg)

    if use_partial
        strategy.exit("TP1", "Long", qty=qty1, stop=sl_p, limit=tp1_p, alert_message="TP1 Long " + syminfo.ticker)
        strategy.exit("TP2", "Long",           stop=sl_p, limit=tp2_p, alert_message="TP2 Long " + syminfo.ticker)
    else
        strategy.exit("Exit Long", "Long", stop=sl_p, limit=tp1_p, alert_message="Close Long " + syminfo.ticker)

    label.new(bar_index, low - atr_val * 0.5, text="BUY\nSL:" + format_price(sl_p) + "\nTP:" + format_price(tp1_p),
              style=label.style_label_up, color=color.new(#089981, 0), textcolor=color.white, size=size.tiny)

    if show_fvg_boxes
        box.new(left=bar_index - 2, top=low, right=bar_index, bottom=high[2],
                bgcolor=color.new(#089981, 85), border_color=color.new(#089981, 50))
        box.new(left=bar_index, top=entry_p, right=bar_index + 1, bottom=sl_p,
                bgcolor=color.new(color.red, 80), border_color=color.new(color.red, 50))
        box.new(left=bar_index, top=tp1_p, right=bar_index + 1, bottom=entry_p,
                bgcolor=color.new(#089981, 80), border_color=color.new(#089981, 50))

// --- SHORT ENTRY ---
if sell_signal
    entry_p      := close
    sl_p         := close + sl_dist
    tp1_p        := close - tp_pips
    tp2_p        := close - (atr_val * tp2_atr_mult)
    target_qty   := calc_order_qty()
    trailing     := false
    tp1_hit      := false
    be_activated := false

    if use_partial
        qty1 := target_qty * (scale_pct / 100.0)
        qty2 := target_qty - qty1
    else
        qty1 := target_qty
        qty2 := 0.0

    short_msg = "SCALP SELL " + syminfo.ticker + " @ " + format_price(close) + " | SL: " + format_price(sl_p) + " | TP1: " + format_price(tp1_p)
    alert(short_msg, alert.freq_once_per_bar_close)

    strategy.entry("Short", strategy.short, qty=target_qty, alert_message=short_msg)

    if use_partial
        strategy.exit("TP1", "Short", qty=qty1, stop=sl_p, limit=tp1_p, alert_message="TP1 Short " + syminfo.ticker)
        strategy.exit("TP2", "Short",           stop=sl_p, limit=tp2_p, alert_message="TP2 Short " + syminfo.ticker)
    else
        strategy.exit("Exit Short", "Short", stop=sl_p, limit=tp1_p, alert_message="Close Short " + syminfo.ticker)

    label.new(bar_index, high + atr_val * 0.5, text="SELL\nSL:" + format_price(sl_p) + "\nTP:" + format_price(tp1_p),
              style=label.style_label_down, color=color.new(#f23645, 0), textcolor=color.white, size=size.tiny)

    if show_fvg_boxes
        box.new(left=bar_index - 2, top=low[2], right=bar_index, bottom=high,
                bgcolor=color.new(#f23645, 85), border_color=color.new(#f23645, 50))
        box.new(left=bar_index, top=sl_p, right=bar_index + 1, bottom=entry_p,
                bgcolor=color.new(color.red, 80), border_color=color.new(color.red, 50))
        box.new(left=bar_index, top=entry_p, right=bar_index + 1, bottom=tp1_p,
                bgcolor=color.new(#089981, 80), border_color=color.new(#089981, 50))

// ============================ TRADE MANAGEMENT: EARLY BE & TRAILING ============================
// --- Long Management ---
if strategy.position_size > 0
    be_dist = tp_pips * (be_trigger_pct / 100.0)

    // 1. Early Break-Even trigger at 45-50% TP1 (+2.25-2.5 pips)
    if use_early_be and not be_activated and not tp1_hit and high >= (entry_p + be_dist)
        be_activated := true
        sl_p := math.max(sl_p, entry_p + trail_be_offset)

    // 2. TP1 hit -> scale out & lock profit
    if not tp1_hit and high >= tp1_p
        tp1_hit      := true
        be_activated := true
        trailing     := true
        sl_p         := math.max(sl_p, entry_p + trail_be_offset)

    // 3. Trail runner stop
    if trailing and use_trail_scalp
        new_trail = high - atr_val * trail_atr_mult
        if new_trail > sl_p
            sl_p := new_trail

    if use_partial
        strategy.exit("TP1", "Long", qty=qty1, stop=sl_p, limit=tp1_p, alert_message="TP1 Long " + syminfo.ticker)
        strategy.exit("TP2", "Long",           stop=sl_p, limit=tp2_p, alert_message="Trail Long " + syminfo.ticker)
    else
        strategy.exit("Exit Long", "Long", stop=sl_p, limit=tp1_p, alert_message="Trail Long " + syminfo.ticker)

// --- Short Management ---
if strategy.position_size < 0
    be_dist = tp_pips * (be_trigger_pct / 100.0)

    // 1. Early Break-Even trigger at 45-50% TP1 (+2.25-2.5 pips)
    if use_early_be and not be_activated and not tp1_hit and low <= (entry_p - be_dist)
        be_activated := true
        sl_p := math.min(sl_p, entry_p - trail_be_offset)

    // 2. TP1 hit -> scale out & lock profit
    if not tp1_hit and low <= tp1_p
        tp1_hit      := true
        be_activated := true
        trailing     := true
        sl_p         := math.min(sl_p, entry_p - trail_be_offset)

    // 3. Trail runner stop
    if trailing and use_trail_scalp
        new_trail = low + atr_val * trail_atr_mult
        if new_trail < sl_p
            sl_p := new_trail

    if use_partial
        strategy.exit("TP1", "Short", qty=qty1, stop=sl_p, limit=tp1_p, alert_message="TP1 Short " + syminfo.ticker)
        strategy.exit("TP2", "Short",           stop=sl_p, limit=tp2_p, alert_message="Trail Short " + syminfo.ticker)
    else
        strategy.exit("Exit Short", "Short", stop=sl_p, limit=tp1_p, alert_message="Trail Short " + syminfo.ticker)

// ============================ SIGNAL MARKERS ============================
plotshape(buy_signal,  title="Buy Signal",  location=location.belowbar, color=color.green, style=shape.triangleup,   size=size.tiny)
plotshape(sell_signal, title="Sell Signal", location=location.abovebar, color=color.red,   style=shape.triangledown, size=size.tiny)

// Cooldown background
bgcolor(in_cooldown ? color.new(#ff9800, 92) : na, title="Cooldown Active")

// ============================ ON-CHART STATS DASHBOARD ============================
var table stats = table.new(position.bottom_right, 2, 9, bgcolor=color.new(color.black, 70), border_color=color.new(color.gray, 60), border_width=1, frame_color=color.new(color.gray, 60), frame_width=1)

if show_dashboard and barstate.islast
    total  = strategy.closedtrades
    wins   = strategy.wintrades
    losses = strategy.losstrades

    wr     = total > 0 ? (wins / total) * 100 : 0.0
    lr     = total > 0 ? (losses / total) * 100 : 0.0
    net    = strategy.netprofit
    dd     = strategy.max_drawdown
    avg_tr = total > 0 ? net / total : 0.0
    pf     = strategy.grossloss != 0 ? math.abs(strategy.grossprofit / strategy.grossloss) : 0.0

    table.cell(stats, 0, 0, "Scalper v3.1 Stats", text_color=color.white, text_size=size.small, text_halign=text.align_left, bgcolor=color.new(#1565c0, 60))
    table.cell(stats, 1, 0, "Value",              text_color=color.white, text_size=size.small, text_halign=text.align_right, bgcolor=color.new(#1565c0, 60))

    table.cell(stats, 0, 1, "Total Trades",  text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(stats, 1, 1, str.tostring(total), text_color=color.white, text_size=size.small, text_halign=text.align_right)

    table.cell(stats, 0, 2, "Win Rate",      text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(stats, 1, 2, str.tostring(wr, "#.##") + "%", text_color=wr >= 60 ? color.new(#089981, 0) : color.new(#f23645, 0), text_size=size.small, text_halign=text.align_right)

    table.cell(stats, 0, 3, "Profit Factor", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(stats, 1, 3, str.tostring(pf, "#.###"), text_color=pf >= 1.8 ? color.new(#089981, 0) : color.new(#f23645, 0), text_size=size.small, text_halign=text.align_right)

    table.cell(stats, 0, 4, "Net Profit",    text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(stats, 1, 4, "$" + str.tostring(net, "#.##"), text_color=net > 0 ? color.new(#089981, 0) : color.new(#f23645, 0), text_size=size.small, text_halign=text.align_right)

    table.cell(stats, 0, 5, "Avg Trade",     text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(stats, 1, 5, "$" + str.tostring(avg_tr, "#.##"), text_color=avg_tr > 0 ? color.new(#089981, 0) : color.new(#f23645, 0), text_size=size.small, text_halign=text.align_right)

    table.cell(stats, 0, 6, "Max Drawdown",  text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(stats, 1, 6, "$" + str.tostring(dd, "#.##"), text_color=color.new(#f23645, 0), text_size=size.small, text_halign=text.align_right)

    table.cell(stats, 0, 7, "Today Trades",  text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(stats, 1, 7, str.tostring(daily_trade_count) + " / " + str.tostring(max_daily_trades), text_color=color.white, text_size=size.small, text_halign=text.align_right)

    table.cell(stats, 0, 8, "Cooldown",      text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(stats, 1, 8, in_cooldown ? "ACTIVE ⏸" : "OFF", text_color=in_cooldown ? color.new(#ff9800, 0) : color.new(#089981, 0), text_size=size.small, text_halign=text.align_right)
