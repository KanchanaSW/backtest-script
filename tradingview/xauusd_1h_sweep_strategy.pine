//@version=6
// ==========================================================================================
// Merged 1H Sweep + Pro Management [Clean & Fast Edition]
// Compatible Assets: XAUUSD (Gold), Forex (EURUSD, GBPUSD), Crypto, Indices
// Recommended Timeframe: 5-minute (M5)
//
// STRATEGY LOGIC:
// 1. HTF Sweep: Monitors previous completed 1-Hour High / Low for liquidity sweeps.
// 2. Market Structure Shift (MSS): Reversal confirmed by crossing recent pivot swing.
// 3. FVG Confirmation: Enters on Fair Value Gap formation.
// 4. Pro Risk & Trade Management:
//    - TP1: Partial profit scale-out (50% default).
//    - Break-Even: Stop loss moved to entry price once TP1 is hit.
//    - Trailing Stop: Trails runner with ATR distance after TP1.
//    - Circuit Breaker: Max consecutive daily loss limit.
//    - Weekend Flatten: Closes open positions Friday afternoon.
// ==========================================================================================

strategy("Merged 1H Sweep + Pro Management [Fast]", 
         overlay=true, 
         initial_capital=5000, 
         default_qty_type=strategy.percent_of_equity, 
         default_qty_value=10, 
         margin_long=0, 
         margin_short=0, 
         process_orders_on_close=false,
         max_labels_count=500, 
         max_boxes_count=500)

// ============================ INPUTS ============================
// --- Sizing Mode ---
grpSize       = "Position Sizing"
sizing_mode   = input.string("Percent of Equity", "Sizing Mode", options=["Percent of Equity", "Fixed Quantity", "Lots (Gold / FX)"], group=grpSize)
equity_pct    = input.float(10.0, "Equity % per Trade", minval=1.0, maxval=100.0, group=grpSize)
fixed_qty     = input.float(1.0, "Fixed Quantity / Contracts", minval=0.001, group=grpSize)
lot_size      = input.float(0.1, "Lot Size", minval=0.01, group=grpSize)
units_per_lot = input.float(100.0, "Units per Lot (100=Gold, 100000=Forex)", minval=1.0, group=grpSize)

// --- Risk & Management ---
grpRisk        = "Risk & Trade Management"
atr_sl_mult    = input.float(2.5, "ATR Stop Loss Multiplier", minval=0.5, step=0.1, group=grpRisk)
tp1_ratio      = input.float(1.5, "TP1 Risk/Reward Ratio", minval=0.5, step=0.1, group=grpRisk)
tp2_ratio      = input.float(2.5, "TP2 Risk/Reward Ratio", minval=1.0, step=0.1, group=grpRisk)
scale_pct      = input.int(50, "TP1 Scale Out %", minval=10, maxval=90, group=grpRisk)
use_trail      = input.bool(true, "Trail Stop Loss after TP1 Hit", group=grpRisk)
trail_atr_mult = input.float(1.5, "Trailing ATR Multiplier", minval=0.5, step=0.1, group=grpRisk)
max_daily_loss = input.int(2, "Max Consecutive Daily Losses", minval=1, group=grpRisk)
close_friday   = input.bool(true, "Close All Trades Friday at 16:00", group=grpRisk)

// --- Setup & ICT Filters ---
grpSetup       = "ICT Strategy & Filters"
htf            = input.timeframe("60", "HTF Sweep Timeframe", group=grpSetup)
swing_len      = input.int(3, "Swing Pivot Length", minval=1, maxval=10, group=grpSetup)
fvg_timeout    = input.int(10, "Max Bars to Wait for FVG", minval=3, maxval=30, group=grpSetup)
use_vol        = input.bool(false, "Use Volume Filter", group=grpSetup, tooltip="Require volume above MA. Keep false if trading Forex without centralized volume.")
vol_length     = input.int(30, "Volume MA Length", minval=5, group=grpSetup)
use_bias       = input.bool(false, "Use Daily Trend Filter", group=grpSetup, tooltip="Require longs above and shorts below Daily EMA.")
bias_tf        = input.timeframe("D", "Trend Timeframe", group=grpSetup)
bias_length    = input.int(20, "Trend EMA Length", group=grpSetup)
max_chase_atr  = input.float(0.0, "Max Chase From Sweep (0 = Disabled)", minval=0.0, step=0.25, group=grpSetup, tooltip="Set to 0 to disable chase filter. Values below 1.5 can filter out most valid trades.")

// --- Session Filter ---
grpSess        = "Trading Session"
use_session    = input.bool(false, "Use Session Time Filter", group=grpSess)
trading_hours  = input.session("0300-1200", "Trading Hours (NY Time)", group=grpSess)
session_tz     = input.string("America/New_York", "Timezone", group=grpSess)

// --- Visuals ---
grpVis         = "Visuals"
show_boxes     = input.bool(true, "Draw Risk/Reward Boxes", group=grpVis)
show_dashboard = input.bool(true, "Show Performance Dashboard", group=grpVis)

// ============================ CALCULATIONS ============================
// Order quantity calculation based on user selection
calc_order_qty() =>
    qty = 1.0
    if sizing_mode == "Percent of Equity"
        notional = strategy.equity * (equity_pct / 100.0)
        qty := notional / close
    else if sizing_mode == "Fixed Quantity"
        qty := fixed_qty
    else
        qty := lot_size * units_per_lot
    math.max(qty, syminfo.mincontract)

atr_val     = ta.atr(14)
sl_distance = atr_val * atr_sl_mult
trail_dist  = atr_val * trail_atr_mult
vol_ma      = ta.sma(volume, vol_length)

// ============================ CIRCUIT BREAKER ============================
var int daily_losses       = 0
var int last_closed_trades = 0

if timeframe.change("D")
    daily_losses := 0

if strategy.closedtrades > last_closed_trades
    if strategy.losstrades > strategy.losstrades[1]
        daily_losses += 1
    else if strategy.wintrades > strategy.wintrades[1]
        daily_losses := 0
    last_closed_trades := strategy.closedtrades

can_trade = daily_losses < max_daily_loss

// ============================ WEEKEND CLOSE ============================
is_friday_close = close_friday and dayofweek == dayofweek.friday and hour >= 16
if is_friday_close
    strategy.close_all(comment="Weekend Flatten")

// ============================ HTF LEVELS & SWEEP LOGIC ============================
// Non-repainting previous completed HTF bar levels
htf_high = request.security(syminfo.tickerid, htf, high[1], barmerge.gaps_off, barmerge.lookahead_off)
htf_low  = request.security(syminfo.tickerid, htf, low[1], barmerge.gaps_off, barmerge.lookahead_off)

// Swing pivots for MSS
ph = ta.pivothigh(high, swing_len, swing_len)
pl = ta.pivotlow(low, swing_len, swing_len)

var float last_ph = na
var float last_pl = na
if not na(ph)
    last_ph := ph
if not na(pl)
    last_pl := pl

bullish_sweep = low < htf_low and close > htf_low
bearish_sweep = high > htf_high and close < htf_high

var bool  swept_bullish       = false
var bool  swept_bearish       = false
var float sweep_low_val       = na
var float sweep_high_val      = na
var float armed_bull_extreme  = na
var float armed_bear_extreme  = na

if bullish_sweep
    swept_bullish  := true
    swept_bearish  := false
    sweep_low_val  := low
if bearish_sweep
    swept_bearish  := true
    swept_bullish  := false
    sweep_high_val := high

// Invalidate if price pushes past sweep extreme prior to shift
if swept_bullish and close < sweep_low_val
    swept_bullish := false
if swept_bearish and close > sweep_high_val
    swept_bearish := false

// Market Structure Shift
bullish_shift = swept_bullish and ta.crossover(close, last_ph)
bearish_shift = swept_bearish and ta.crossunder(close, last_pl)

var bool wait_for_fvg_bull = false
var bool wait_for_fvg_bear = false
var int  bars_since_shift  = 0

if bullish_shift
    wait_for_fvg_bull  := true
    swept_bullish      := false 
    bars_since_shift   := 0
    armed_bull_extreme := sweep_low_val
if bearish_shift
    wait_for_fvg_bear  := true
    swept_bearish      := false 
    bars_since_shift   := 0
    armed_bear_extreme := sweep_high_val

if wait_for_fvg_bull or wait_for_fvg_bear
    bars_since_shift += 1

if bars_since_shift > fvg_timeout
    wait_for_fvg_bull := false
    wait_for_fvg_bear := false

// ============================ ENTRY CONDITIONS ============================
// Standard ICT Fair Value Gap
fvg_bull = low > high[2] and close[1] > open[1]
fvg_bear = high < low[2] and close[1] < open[1]

vol_cond = not use_vol or (volume > vol_ma)

bias_ema    = request.security(syminfo.tickerid, bias_tf, ta.ema(close, bias_length)[1], barmerge.gaps_off, barmerge.lookahead_off)
long_trend  = not use_bias or (not na(bias_ema) and close > bias_ema)
short_trend = not use_bias or (not na(bias_ema) and close < bias_ema)

long_chase  = max_chase_atr <= 0 or (not na(armed_bull_extreme) and (close - armed_bull_extreme) <= (atr_val * max_chase_atr))
short_chase = max_chase_atr <= 0 or (not na(armed_bear_extreme) and (armed_bear_extreme - close) <= (atr_val * max_chase_atr))

in_session  = not use_session or not na(time(timeframe.period, trading_hours, session_tz))
can_enter   = in_session and strategy.position_size == 0 and can_trade and not is_friday_close

buy_signal  = wait_for_fvg_bull and fvg_bull and vol_cond and long_trend and long_chase and can_enter
sell_signal = wait_for_fvg_bear and fvg_bear and vol_cond and short_trend and short_chase and can_enter

if buy_signal
    wait_for_fvg_bull := false
if sell_signal
    wait_for_fvg_bear := false

// Visual arrows on chart
plotshape(buy_signal, title="Buy Signal", location=location.belowbar, color=color.green, style=shape.triangleup, size=size.small)
plotshape(sell_signal, title="Sell Signal", location=location.abovebar, color=color.red, style=shape.triangledown, size=size.small)

// ============================ EXECUTION ENGINE ============================
var float entry_p    = na
var float sl_p       = na
var float tp1_p      = na
var float tp2_p      = na
var float target_qty = na
var float qty1       = na
var float qty2       = na
var bool  tp1_hit    = false

var box sl_box       = na
var box tp1_box      = na
var box tp2_box      = na

// --- LONG ENTRY ---
if buy_signal
    entry_p    := close
    sl_p       := entry_p - sl_distance
    tp1_p      := entry_p + (sl_distance * tp1_ratio)
    tp2_p      := entry_p + (sl_distance * tp2_ratio)
    target_qty := calc_order_qty()
    qty1       := target_qty * (scale_pct / 100.0)
    qty2       := target_qty - qty1
    tp1_hit    := false

    strategy.entry("Long", strategy.long, qty=target_qty)
    strategy.exit("TP1", "Long", qty=qty1, stop=sl_p, limit=tp1_p)
    strategy.exit("TP2", "Long", stop=sl_p, limit=tp2_p)

    label.new(bar_index, low - atr_val, text="BUY\nSL: " + str.tostring(sl_p, "#.##") + "\nTP1: " + str.tostring(tp1_p, "#.##"), 
              style=label.style_label_up, color=color.new(#089981, 0), textcolor=color.white, size=size.small)

    if show_boxes
        sl_box  := box.new(left=bar_index, top=entry_p, right=bar_index + 1, bottom=sl_p, bgcolor=color.new(color.red, 80), border_color=color.new(color.red, 50))
        tp1_box := box.new(left=bar_index, top=tp1_p, right=bar_index + 1, bottom=entry_p, bgcolor=color.new(#089981, 70), border_color=color.new(#089981, 50))
        tp2_box := box.new(left=bar_index, top=tp2_p, right=bar_index + 1, bottom=tp1_p, bgcolor=color.new(#089981, 85), border_color=color.new(#089981, 50))

// Manage Active Long
if strategy.position_size > 0
    if not tp1_hit and high >= tp1_p
        tp1_hit := true
        if use_trail
            sl_p := entry_p // Move stop to Break-Even

    if tp1_hit and use_trail
        new_trail = high - trail_dist
        if new_trail > sl_p
            sl_p := new_trail

    strategy.exit("TP1", "Long", qty=qty1, stop=sl_p, limit=tp1_p)
    strategy.exit("TP2", "Long", stop=sl_p, limit=tp2_p)

    if not na(sl_box)
        box.set_bottom(sl_box, sl_p)

// --- SHORT ENTRY ---
if sell_signal
    entry_p    := close
    sl_p       := entry_p + sl_distance
    tp1_p      := entry_p - (sl_distance * tp1_ratio)
    tp2_p      := entry_p - (sl_distance * tp2_ratio)
    target_qty := calc_order_qty()
    qty1       := target_qty * (scale_pct / 100.0)
    qty2       := target_qty - qty1
    tp1_hit    := false

    strategy.entry("Short", strategy.short, qty=target_qty)
    strategy.exit("TP1", "Short", qty=qty1, stop=sl_p, limit=tp1_p)
    strategy.exit("TP2", "Short", stop=sl_p, limit=tp2_p)

    label.new(bar_index, high + atr_val, text="SELL\nSL: " + str.tostring(sl_p, "#.##") + "\nTP1: " + str.tostring(tp1_p, "#.##"), 
              style=label.style_label_down, color=color.new(#f23645, 0), textcolor=color.white, size=size.small)

    if show_boxes
        sl_box  := box.new(left=bar_index, top=sl_p, right=bar_index + 1, bottom=entry_p, bgcolor=color.new(color.red, 80), border_color=color.new(color.red, 50))
        tp1_box := box.new(left=bar_index, top=entry_p, right=bar_index + 1, bottom=tp1_p, bgcolor=color.new(#089981, 70), border_color=color.new(#089981, 50))
        tp2_box := box.new(left=bar_index, top=tp1_p, right=bar_index + 1, bottom=tp2_p, bgcolor=color.new(#089981, 85), border_color=color.new(#089981, 50))

// Manage Active Short
if strategy.position_size < 0
    if not tp1_hit and low <= tp1_p
        tp1_hit := true
        if use_trail
            sl_p := entry_p // Move stop to Break-Even

    if tp1_hit and use_trail
        new_trail = low + trail_dist
        if new_trail < sl_p
            sl_p := new_trail

    strategy.exit("TP1", "Short", qty=qty1, stop=sl_p, limit=tp1_p)
    strategy.exit("TP2", "Short", stop=sl_p, limit=tp2_p)

    if not na(sl_box)
        box.set_top(sl_box, sl_p)

// Extend boxes while active
if strategy.position_size != 0
    if not na(sl_box)
        box.set_right(sl_box, bar_index)
    if not na(tp1_box)
        box.set_right(tp1_box, bar_index)
    if not na(tp2_box)
        box.set_right(tp2_box, bar_index)

// ============================ ON-CHART STATS DASHBOARD ============================
var table stats_table = table.new(position.bottom_right, 2, 6, bgcolor=color.new(color.black, 70), border_color=color.new(color.gray, 60), border_width=1, frame_color=color.new(color.gray, 60), frame_width=1)

if show_dashboard and barstate.islast
    total_trades = strategy.closedtrades
    win_trades   = strategy.wintrades
    loss_trades  = strategy.losstrades

    win_rate  = total_trades > 0 ? (win_trades / total_trades) * 100 : 0.0
    loss_rate = total_trades > 0 ? (loss_trades / total_trades) * 100 : 0.0
    net_prof  = strategy.netprofit
    max_dd    = strategy.max_drawdown

    table.cell(stats_table, 0, 0, "Strategy Stats", text_color=color.white, text_size=size.small, text_halign=text.align_left, bgcolor=color.new(color.blue, 60))
    table.cell(stats_table, 1, 0, "Value", text_color=color.white, text_size=size.small, text_halign=text.align_right, bgcolor=color.new(color.blue, 60))

    table.cell(stats_table, 0, 1, "Total Trades", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(stats_table, 1, 1, str.tostring(total_trades), text_color=color.white, text_size=size.small, text_halign=text.align_right)

    table.cell(stats_table, 0, 2, "Win Rate", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(stats_table, 1, 2, str.tostring(win_rate, "#.##") + "%", text_color=win_rate >= 50 ? color.new(#089981, 0) : color.new(#f23645, 0), text_size=size.small, text_halign=text.align_right)

    table.cell(stats_table, 0, 3, "Loss Rate", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(stats_table, 1, 3, str.tostring(loss_rate, "#.##") + "%", text_color=color.new(#f23645, 0), text_size=size.small, text_halign=text.align_right)

    table.cell(stats_table, 0, 4, "Net Profit", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(stats_table, 1, 4, "$" + str.tostring(net_prof, "#.##"), text_color=net_prof > 0 ? color.new(#089981, 0) : color.new(#f23645, 0), text_size=size.small, text_halign=text.align_right)

    table.cell(stats_table, 0, 5, "Max Drawdown", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(stats_table, 1, 5, "$" + str.tostring(max_dd, "#.##"), text_color=color.new(#f23645, 0), text_size=size.small, text_halign=text.align_right)
