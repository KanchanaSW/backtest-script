//@version=6
// ==========================================================================================
// XAUUSD M15 Sweep + MSS [A+ Confluence]
// Target Asset: XAUUSD (Gold)
// Recommended Timeframe: 15-minute (M15)
//
// ACCOUNT RULES ($5,000 funded):
// - Risk 1% per trade ($50) — position sized from actual stop distance
// - Fixed 1:3 RR single target (proven edge on this sample; partials optional)
// - Daily loss cap 2% ($100) — block new entries until next day
// - Max 2 trades/day, one position at a time
//
// SETUP (A+ only — confluence score >= min_score):
// 1. H4 bias (EMA)
// 2. Liquidity sweep of prior swing or Asian range, close back inside
// 3. Market structure shift with displacement within N bars
// 4. Entry on MSS close (pullback modes available)
// 5. Stop beyond sweep wick; reject if SL too wide/tight
// ==========================================================================================

strategy("XAUUSD M15 Sweep+MSS [A+]",
         overlay=true,
         initial_capital=5000,
         default_qty_type=strategy.fixed,
         default_qty_value=1,
         margin_long=0,
         margin_short=0,
         process_orders_on_close=false,
         max_labels_count=500,
         max_boxes_count=500,
         max_lines_count=500,
         commission_type=strategy.commission.cash_per_order,
         commission_value=0)

// ============================ INPUTS ============================
// --- Risk ---
grpRisk           = "Risk & Account"
account_equity    = input.float(5000.0, "Account Equity ($)", minval=100.0, group=grpRisk)
risk_pct          = input.float(1.0, "Risk % per Trade", minval=0.1, maxval=5.0, step=0.1, group=grpRisk)
rr_ratio          = input.float(3.0, "Reward:Risk Ratio (Final TP)", minval=1.0, maxval=5.0, step=0.5, group=grpRisk, tooltip="Full target R:R. Keep at 3.0 — this is where the edge lived (+$152 run).")
daily_loss_pct    = input.float(2.0, "Daily Loss Cap %", minval=0.5, maxval=5.0, step=0.5, group=grpRisk)
max_trades_day    = input.int(2, "Max Trades per Day", minval=1, maxval=10, group=grpRisk)
qty_round_mode    = input.string("Nearest", "Qty Rounding", options=["Nearest", "Ceil (max risk)", "Floor (min risk)"], group=grpRisk, tooltip="Nearest keeps losses closest to 1%.")
close_friday      = input.bool(true, "Flatten Friday ≥ 16:00 Exchange", group=grpRisk)
block_ny_last_min = input.int(30, "Block Entries Last N Min of NY", minval=0, maxval=60, group=grpRisk)

// --- Trade Management (expectancy-first) ---
grpWR             = "Trade Management"
use_partial       = input.bool(false, "Scale Out 50% at TP1", group=grpWR, tooltip="OFF by default. Partials inflate TV trade count and diluted the +$152 single-target edge to ~breakeven.")
tp1_ratio         = input.float(1.5, "TP1 Scale-Out (× Risk)", minval=0.5, maxval=3.0, step=0.1, group=grpWR)
scale_pct         = input.int(50, "TP1 Scale Out %", minval=20, maxval=80, group=grpWR)
use_be            = input.bool(false, "Move SL to BE After TP1", group=grpWR, tooltip="Only used when Scale Out is ON.")
be_offset_atr     = input.float(0.05, "BE Profit Offset (x ATR)", minval=0.0, step=0.05, group=grpWR)
use_m15_ema       = input.bool(false, "Require M15 EMA Momentum", group=grpWR, tooltip="OFF by default — the profitable sample did not use this filter.")
m15_ema_len       = input.int(21, "M15 EMA Length", minval=8, maxval=100, group=grpWR)
require_confirm   = input.bool(false, "Require Directional Close on Entry", group=grpWR)

// --- Sessions ---
grpSess           = "Trading Sessions"
use_session       = input.bool(true, "Use Killzone Filter", group=grpSess)
london_session    = input.session("0300-0700", "London Killzone (NY)", group=grpSess)
ny_session        = input.session("0830-1200", "NY Killzone (NY)", group=grpSess)
session_tz        = input.string("America/New_York", "Timezone", group=grpSess)
asian_session     = input.session("1900-0200", "Asian Range Session (NY)", group=grpSess)

// --- HTF Bias ---
grpHTF            = "HTF Bias (H4)"
use_htf_bias      = input.bool(true, "Require H4 Bias Alignment", group=grpHTF)
htf_tf            = input.timeframe("240", "Bias Timeframe", group=grpHTF)
htf_ema_len       = input.int(50, "H4 EMA Length", minval=10, maxval=200, group=grpHTF)
htf_swing_len     = input.int(3, "H4 Swing Pivot Length", minval=1, maxval=10, group=grpHTF)
require_htf_struct = input.bool(false, "Also Require H4 Swing Structure", group=grpHTF, tooltip="Off by default — H4 close above last swing high is rare and starved trade count.")

// --- Sweep / MSS ---
grpSetup          = "Sweep & MSS"
swing_len         = input.int(3, "M15 Swing Pivot Length", minval=2, maxval=20, group=grpSetup)
use_asian_liq     = input.bool(true, "Also Sweep Asian High/Low", group=grpSetup)
max_sweep_bars    = input.int(20, "Max Bars Sweep → MSS", minval=3, maxval=40, group=grpSetup)
disp_atr_mult     = input.float(0.45, "Min Displacement Body (x ATR)", minval=0.2, maxval=2.0, step=0.05, group=grpSetup)
sweep_buf_mult    = input.float(0.1, "SL Buffer Beyond Sweep (x ATR)", minval=0.0, step=0.05, group=grpSetup)
max_sl_atr        = input.float(2.0, "Max SL Width (x H1 ATR)", minval=0.5, maxval=4.0, step=0.1, group=grpSetup)
min_sl_atr        = input.float(0.15, "Min SL Width (x M15 ATR)", minval=0.05, maxval=1.0, step=0.05, group=grpSetup)
entry_mode        = input.string("MSS Close", "Entry Mode", options=["MSS Close", "FVG Retrace", "50% Displacement", "Pullback (FVG or 50%)"], group=grpSetup, tooltip="MSS Close matched the best backtest (+$152). Pullback is optional.")
fvg_timeout       = input.int(12, "Max Bars Wait for Retrace Entry", minval=2, maxval=30, group=grpSetup)
mss_entry_bars    = input.int(2, "MSS Close Entry Window (bars)", minval=1, maxval=5, group=grpSetup, tooltip="Allow entry on MSS bar and next N-1 bars.")
atr_length        = input.int(14, "ATR Length", minval=5, maxval=50, group=grpSetup)

// --- Confluence ---
grpConf           = "Confluence Score (A+)"
min_score         = input.int(3, "Minimum Score to Trade (0-5)", minval=1, maxval=5, group=grpConf, tooltip="1=H4 bias 2=liq sweep 3=strong displacement 4=FVG/Asian 5=killzone")
disp_score_mult   = input.float(0.45, "Strong Displacement Threshold (x ATR)", minval=0.3, maxval=2.5, step=0.05, group=grpConf)

// --- Filters ---
grpFilt           = "Volatility Filters"
use_atr_spike     = input.bool(true, "Skip ATR Spike Bars", group=grpFilt)
atr_spike_mult    = input.float(2.0, "ATR Spike vs SMA", minval=1.2, maxval=4.0, step=0.1, group=grpFilt)
atr_sma_len       = input.int(50, "ATR SMA Length", minval=10, maxval=100, group=grpFilt)

// --- Visuals ---
grpVis            = "Visuals"
show_boxes        = input.bool(true, "Draw Risk/Reward Boxes", group=grpVis)
show_sweep_lines  = input.bool(true, "Mark Sweep Levels", group=grpVis)
show_dashboard    = input.bool(true, "Show Info Dashboard", group=grpVis)
show_htf_ema      = input.bool(true, "Plot H4 EMA", group=grpVis)

// ============================ HELPERS ============================
format_price(float p) =>
    if syminfo.mintick < 0.001
        str.tostring(p, "#.#####")
    else if syminfo.mintick < 0.1
        str.tostring(p, "#.##")
    else
        str.tostring(p, "#.#")

// Risk-based sizing for OANDA/TV Gold: qty units ≈ risk$ / (stop × pointvalue)
calc_risk_qty(float stop_dist) =>
    float risk_usd = account_equity * (risk_pct / 100.0)
    float pv = syminfo.pointvalue == 0 ? 1.0 : syminfo.pointvalue
    float raw = 0.0
    if stop_dist > 0 and pv > 0
        raw := risk_usd / (stop_dist * pv)
    float step = syminfo.mincontract > 0 ? syminfo.mincontract : 1.0
    float qty = raw
    if qty_round_mode == "Floor (min risk)"
        qty := math.floor(raw / step) * step
    else if qty_round_mode == "Ceil (max risk)"
        qty := math.ceil(raw / step) * step
    else
        qty := math.round(raw / step) * step
    math.max(qty, step)

in_sess(string sess) =>
    not na(time(timeframe.period, sess, session_tz))

// ============================ INDICATORS ============================
atr_m15     = ta.atr(atr_length)
atr_sma     = ta.sma(atr_m15, atr_sma_len)
atr_h1      = request.security(syminfo.tickerid, "60", ta.atr(atr_length)[1], barmerge.gaps_off, barmerge.lookahead_off)
m15_ema     = ta.ema(close, m15_ema_len)
m15_ema_bull = not use_m15_ema or close > m15_ema
m15_ema_bear = not use_m15_ema or close < m15_ema

// ============================ HTF BIAS (H4, non-repainting) ============================
htf_close   = request.security(syminfo.tickerid, htf_tf, close[1], barmerge.gaps_off, barmerge.lookahead_off)
htf_ema     = request.security(syminfo.tickerid, htf_tf, ta.ema(close, htf_ema_len)[1], barmerge.gaps_off, barmerge.lookahead_off)
htf_ph_raw  = request.security(syminfo.tickerid, htf_tf, ta.pivothigh(high, htf_swing_len, htf_swing_len)[1], barmerge.gaps_off, barmerge.lookahead_off)
htf_pl_raw  = request.security(syminfo.tickerid, htf_tf, ta.pivotlow(low, htf_swing_len, htf_swing_len)[1], barmerge.gaps_off, barmerge.lookahead_off)

var float htf_last_ph = na
var float htf_last_pl = na
if not na(htf_ph_raw)
    htf_last_ph := htf_ph_raw
if not na(htf_pl_raw)
    htf_last_pl := htf_pl_raw

htf_ema_bull = not na(htf_close) and not na(htf_ema) and htf_close > htf_ema
htf_ema_bear = not na(htf_close) and not na(htf_ema) and htf_close < htf_ema
htf_struct_bull = not require_htf_struct or (not na(htf_last_ph) and not na(htf_close) and htf_close > htf_last_ph)
htf_struct_bear = not require_htf_struct or (not na(htf_last_pl) and not na(htf_close) and htf_close < htf_last_pl)

htf_bull = not use_htf_bias or (htf_ema_bull and htf_struct_bull)
htf_bear = not use_htf_bias or (htf_ema_bear and htf_struct_bear)

plot(show_htf_ema and not na(htf_ema) ? htf_ema : na, title="H4 EMA", color=color.new(#787b86, 40), linewidth=2)
plot(use_m15_ema ? m15_ema : na, title="M15 EMA", color=color.new(#2962ff, 50), linewidth=1)

// ============================ ASIAN RANGE ============================
var float asian_high = na
var float asian_low  = na
var bool  asian_built = false

new_day = timeframe.change("D")
in_asian = in_sess(asian_session)

if new_day
    asian_high := na
    asian_low  := na
    asian_built := false

if in_asian
    asian_high := na(asian_high) ? high : math.max(asian_high, high)
    asian_low  := na(asian_low) ? low : math.min(asian_low, low)
else if not na(asian_high) and not na(asian_low)
    asian_built := true

// ============================ M15 SWINGS ============================
ph = ta.pivothigh(high, swing_len, swing_len)
pl = ta.pivotlow(low, swing_len, swing_len)

var float last_ph = na
var float last_pl = na
if not na(ph)
    last_ph := ph
if not na(pl)
    last_pl := pl

// ============================ LIQUIDITY SWEEP ============================
swing_bull_sweep = not na(last_pl) and low < last_pl and close > last_pl
swing_bear_sweep = not na(last_ph) and high > last_ph and close < last_ph

asian_bull_sweep = use_asian_liq and asian_built and not na(asian_low) and low < asian_low and close > asian_low
asian_bear_sweep = use_asian_liq and asian_built and not na(asian_high) and high > asian_high and close < asian_high

bullish_sweep = swing_bull_sweep or asian_bull_sweep
bearish_sweep = swing_bear_sweep or asian_bear_sweep

is_asian_liq_bull = asian_bull_sweep
is_asian_liq_bear = asian_bear_sweep

var bool  swept_bullish         = false
var bool  swept_bearish         = false
var float sweep_low_val         = na
var float sweep_high_val        = na
var float armed_bull_extreme    = na
var float armed_bear_extreme    = na
var int   bars_since_sweep_bull = 0
var int   bars_since_sweep_bear = 0
var bool  armed_asian_bull      = false
var bool  armed_asian_bear      = false
var float disp_high_bull        = na
var float disp_low_bull         = na
var float disp_high_bear        = na
var float disp_low_bear         = na
var float fvg_top_bull          = na
var float fvg_bot_bull          = na
var float fvg_top_bear          = na
var float fvg_bot_bear          = na
var bool  wait_entry_bull       = false
var bool  wait_entry_bear       = false
var int   bars_since_mss        = 0
var int   last_score_bull       = 0
var int   last_score_bear       = 0

if bullish_sweep
    swept_bullish         := true
    swept_bearish         := false
    wait_entry_bear       := false
    sweep_low_val         := low
    bars_since_sweep_bull := 0
    armed_asian_bull      := is_asian_liq_bull
    if show_sweep_lines
        line.new(bar_index - 1, low, bar_index + 8, low, color=color.new(#089981, 40), style=line.style_dotted, width=1)
else if swept_bullish
    bars_since_sweep_bull += 1
    if low < sweep_low_val and close > math.min(nz(last_pl, sweep_low_val), nz(asian_low, sweep_low_val))
        sweep_low_val := low

if bearish_sweep
    swept_bearish         := true
    swept_bullish         := false
    wait_entry_bull       := false
    sweep_high_val        := high
    bars_since_sweep_bear := 0
    armed_asian_bear      := is_asian_liq_bear
    if show_sweep_lines
        line.new(bar_index - 1, high, bar_index + 8, high, color=color.new(#f23645, 40), style=line.style_dotted, width=1)
else if swept_bearish
    bars_since_sweep_bear += 1
    if high > sweep_high_val and close < math.max(nz(last_ph, sweep_high_val), nz(asian_high, sweep_high_val))
        sweep_high_val := high

if swept_bullish and (close < sweep_low_val or bars_since_sweep_bull > max_sweep_bars)
    swept_bullish := false
if swept_bearish and (close > sweep_high_val or bars_since_sweep_bear > max_sweep_bars)
    swept_bearish := false

// ============================ MARKET STRUCTURE SHIFT ============================
candle_body = math.abs(close - open)
strong_disp = candle_body >= atr_m15 * disp_atr_mult

bullish_mss = swept_bullish and not na(last_ph) and close > last_ph and strong_disp and close > open
bearish_mss = swept_bearish and not na(last_pl) and close < last_pl and strong_disp and close < open

fvg_bull_now = low > high[2] and close[1] > open[1]
fvg_bear_now = high < low[2] and close[1] < open[1]

// Sessions / killzone
in_london   = in_sess(london_session)
in_ny       = in_sess(ny_session)
in_killzone = not use_session or in_london or in_ny

// Block last N minutes of NY killzone (session ends 12:00 NY by default)
ny_end_block = false
if block_ny_last_min > 0 and in_ny
    int mins = hour(time, session_tz) * 60 + minute(time, session_tz)
    // Parse is hard; use noon NY as default end matching "0830-1200"
    int ny_end = 12 * 60
    ny_end_block := mins >= (ny_end - block_ny_last_min)

atr_ok = not use_atr_spike or na(atr_sma) or atr_m15 <= atr_sma * atr_spike_mult

// Score: bias, any liq sweep (always true at MSS — Asian gets same point; swing also qualifies),
// strong displacement, FVG, killzone
calc_confluence(bool bias_ok, bool liq_ok, bool strong_d, bool has_fvg, bool in_kz) =>
    int s = 0
    if bias_ok
        s += 1
    if liq_ok
        s += 1
    if strong_d
        s += 1
    if has_fvg
        s += 1
    if in_kz
        s += 1
    s

strong_disp_score = candle_body >= atr_m15 * disp_score_mult

if bullish_mss
    armed_bull_extreme := sweep_low_val
    disp_high_bull     := high
    disp_low_bull      := low
    fvg_top_bull       := fvg_bull_now ? low : na
    fvg_bot_bull       := fvg_bull_now ? high[2] : na
    // Liquidity point: swing or Asian sweep both qualify; Asian is preferred premium
    bool liq_ok = true
    bool has_fvg_or_asian = fvg_bull_now or armed_asian_bull
    last_score_bull := calc_confluence(htf_bull, liq_ok, strong_disp_score, has_fvg_or_asian, in_killzone)
    if last_score_bull >= min_score
        wait_entry_bull := true
        wait_entry_bear := false
        bars_since_mss  := 0
    swept_bullish := false

if bearish_mss
    armed_bear_extreme := sweep_high_val
    disp_high_bear     := high
    disp_low_bear      := low
    fvg_top_bear       := fvg_bear_now ? low[2] : na
    fvg_bot_bear       := fvg_bear_now ? high : na
    bool liq_ok = true
    bool has_fvg_or_asian = fvg_bear_now or armed_asian_bear
    last_score_bear := calc_confluence(htf_bear, liq_ok, strong_disp_score, has_fvg_or_asian, in_killzone)
    if last_score_bear >= min_score
        wait_entry_bear := true
        wait_entry_bull := false
        bars_since_mss  := 0
    swept_bearish := false

if wait_entry_bull or wait_entry_bear
    bars_since_mss += 1

if bars_since_mss > fvg_timeout
    wait_entry_bull := false
    wait_entry_bear := false

// Late FVG detection while waiting
if wait_entry_bull and fvg_bull_now and na(fvg_top_bull)
    fvg_top_bull := low
    fvg_bot_bull := high[2]
if wait_entry_bear and fvg_bear_now and na(fvg_top_bear)
    fvg_top_bear := low[2]
    fvg_bot_bear := high

// ============================ ENTRY TRIGGERS ============================
mid_disp_bull = not na(disp_high_bull) and not na(disp_low_bull) ? (disp_high_bull + disp_low_bull) / 2.0 : na
mid_disp_bear = not na(disp_high_bear) and not na(disp_low_bear) ? (disp_high_bear + disp_low_bear) / 2.0 : na

entry_bull_ok = false
entry_bear_ok = false

if wait_entry_bull
    bool fvg_hit = not na(fvg_top_bull) and not na(fvg_bot_bull) and low <= fvg_top_bull and close >= fvg_bot_bull
    bool mid_hit = not na(mid_disp_bull) and low <= mid_disp_bull and close >= mid_disp_bull
    if entry_mode == "MSS Close"
        entry_bull_ok := bars_since_mss >= 1 and bars_since_mss <= mss_entry_bars
    else if entry_mode == "FVG Retrace"
        entry_bull_ok := fvg_hit
    else if entry_mode == "50% Displacement"
        entry_bull_ok := mid_hit
    else // Pullback (FVG or 50%)
        entry_bull_ok := fvg_hit or mid_hit

if wait_entry_bear
    bool fvg_hit = not na(fvg_bot_bear) and not na(fvg_top_bear) and high >= fvg_bot_bear and close <= fvg_top_bear
    bool mid_hit = not na(mid_disp_bear) and high >= mid_disp_bear and close <= mid_disp_bear
    if entry_mode == "MSS Close"
        entry_bear_ok := bars_since_mss >= 1 and bars_since_mss <= mss_entry_bars
    else if entry_mode == "FVG Retrace"
        entry_bear_ok := fvg_hit
    else if entry_mode == "50% Displacement"
        entry_bear_ok := mid_hit
    else
        entry_bear_ok := fvg_hit or mid_hit

// MSS Close: drop pending entry after the window without a fill
if entry_mode == "MSS Close"
    if wait_entry_bull and bars_since_mss > mss_entry_bars
        wait_entry_bull := false
    if wait_entry_bear and bars_since_mss > mss_entry_bars
        wait_entry_bear := false

// ============================ DAILY LOSS CAP & CIRCUIT BREAKER ============================
var float daily_pnl          = 0.0
var int   daily_trade_count  = 0
var int   last_closed_trades = 0
var float day_start_equity   = na

if na(day_start_equity)
    day_start_equity := strategy.equity

if timeframe.change("D")
    daily_pnl         := 0.0
    daily_trade_count := 0
    day_start_equity  := strategy.equity

if strategy.closedtrades > last_closed_trades
    int new_closed = strategy.closedtrades - last_closed_trades
    daily_trade_count += new_closed
    for i = 0 to new_closed - 1
        daily_pnl += strategy.closedtrades.profit(strategy.closedtrades - 1 - i)
    last_closed_trades := strategy.closedtrades

float daily_loss_limit = account_equity * (daily_loss_pct / 100.0) * -1.0
bool  daily_ok         = daily_pnl > daily_loss_limit
bool  trades_ok        = daily_trade_count < max_trades_day

is_friday_close = close_friday and dayofweek == dayofweek.friday and hour(time, session_tz) >= 16
if is_friday_close
    strategy.close_all(comment="Weekend Flatten")

can_enter = in_killzone and not ny_end_block and strategy.position_size == 0 and daily_ok and trades_ok and not is_friday_close and atr_ok and not na(atr_m15) and not na(atr_h1)

// SL width validation helper
sl_width_ok(float entry, float sl) =>
    float dist = math.abs(entry - sl)
    bool too_wide  = dist > atr_h1 * max_sl_atr
    bool too_tight = dist < atr_m15 * min_sl_atr
    dist > 0 and not too_wide and not too_tight

buy_signal  = wait_entry_bull and entry_bull_ok and htf_bull and m15_ema_bull and can_enter and last_score_bull >= min_score and (not require_confirm or close > open)
sell_signal = wait_entry_bear and entry_bear_ok and htf_bear and m15_ema_bear and can_enter and last_score_bear >= min_score and (not require_confirm or close < open)

// ============================ EXECUTION ============================
var float entry_p    = na
var float sl_p       = na
var float tp1_p      = na
var float tp_p       = na
var float sl_dist_r  = na
var float target_qty = na
var float qty1       = na
var float qty2       = na
var int   entry_score = 0
var bool  tp1_hit    = false

var box sl_box  = na
var box tp_box  = na
var box tp1_box = na
var line sweep_ln = na

plotshape(buy_signal, title="Buy", location=location.belowbar, color=color.new(#089981, 0), style=shape.triangleup, size=size.small)
plotshape(sell_signal, title="Sell", location=location.abovebar, color=color.new(#f23645, 0), style=shape.triangledown, size=size.small)

// --- LONG ---
if buy_signal
    entry_p := close
    float tentative_sl = na(armed_bull_extreme) ? entry_p - atr_m15 : armed_bull_extreme - (atr_m15 * sweep_buf_mult)
    if tentative_sl >= entry_p
        tentative_sl := entry_p - atr_m15 * min_sl_atr

    if sl_width_ok(entry_p, tentative_sl)
        sl_p := tentative_sl
        sl_dist_r := entry_p - sl_p
        tp1_p := entry_p + (sl_dist_r * tp1_ratio)
        tp_p := entry_p + (sl_dist_r * rr_ratio)
        target_qty := calc_risk_qty(sl_dist_r)
        if use_partial
            qty1 := target_qty * (scale_pct / 100.0)
            qty2 := target_qty - qty1
        else
            qty1 := target_qty
            qty2 := 0.0
        entry_score := last_score_bull
        tp1_hit := false
        wait_entry_bull := false

        float pv = syminfo.pointvalue == 0 ? 1.0 : syminfo.pointvalue
        float risk_actual = target_qty * sl_dist_r * pv
        long_msg = "BUY " + syminfo.ticker + " @ " + format_price(entry_p) + " | SL: " + format_price(sl_p) + " | TP1: " + format_price(tp1_p) + " | TP: " + format_price(tp_p) + " | R:" + str.tostring(rr_ratio) + " | Score:" + str.tostring(entry_score) + " | Risk:$" + str.tostring(risk_actual, "#.#")
        alert(long_msg, alert.freq_once_per_bar_close)

        strategy.entry("Long", strategy.long, qty=target_qty, alert_message=long_msg)
        if use_partial
            strategy.exit("TP1-Long", "Long", qty=qty1, stop=sl_p, limit=tp1_p, alert_message="TP1 Long " + syminfo.ticker)
            strategy.exit("TP2-Long", "Long", stop=sl_p, limit=tp_p, alert_message="TP2 Long " + syminfo.ticker)
        else
            strategy.exit("XR-Long", "Long", stop=sl_p, limit=tp_p, alert_message="Close Long " + syminfo.ticker)

        label.new(bar_index, low - atr_m15, text="BUY A+\nScore " + str.tostring(entry_score) + "\nSL " + format_price(sl_p) + "\nTP1 " + format_price(tp1_p) + "\nTP " + format_price(tp_p) + "\nRisk $" + str.tostring(risk_actual, "#.#"),
                  style=label.style_label_up, color=color.new(#089981, 0), textcolor=color.white, size=size.small)

        if show_boxes
            sl_box := box.new(left=bar_index, top=entry_p, right=bar_index + 1, bottom=sl_p, bgcolor=color.new(color.red, 80), border_color=color.new(color.red, 50))
            tp1_box := box.new(left=bar_index, top=tp1_p, right=bar_index + 1, bottom=entry_p, bgcolor=color.new(#089981, 70), border_color=color.new(#089981, 50))
            tp_box := box.new(left=bar_index, top=tp_p, right=bar_index + 1, bottom=tp1_p, bgcolor=color.new(#089981, 85), border_color=color.new(#089981, 50))
        if show_sweep_lines and not na(armed_bull_extreme)
            sweep_ln := line.new(bar_index, armed_bull_extreme, bar_index + 20, armed_bull_extreme, color=color.new(#089981, 20), width=2)
    else
        wait_entry_bull := false

// --- SHORT ---
if sell_signal
    entry_p := close
    float tentative_sl = na(armed_bear_extreme) ? entry_p + atr_m15 : armed_bear_extreme + (atr_m15 * sweep_buf_mult)
    if tentative_sl <= entry_p
        tentative_sl := entry_p + atr_m15 * min_sl_atr

    if sl_width_ok(entry_p, tentative_sl)
        sl_p := tentative_sl
        sl_dist_r := sl_p - entry_p
        tp1_p := entry_p - (sl_dist_r * tp1_ratio)
        tp_p := entry_p - (sl_dist_r * rr_ratio)
        target_qty := calc_risk_qty(sl_dist_r)
        if use_partial
            qty1 := target_qty * (scale_pct / 100.0)
            qty2 := target_qty - qty1
        else
            qty1 := target_qty
            qty2 := 0.0
        entry_score := last_score_bear
        tp1_hit := false
        wait_entry_bear := false

        float pv = syminfo.pointvalue == 0 ? 1.0 : syminfo.pointvalue
        float risk_actual = target_qty * sl_dist_r * pv
        short_msg = "SELL " + syminfo.ticker + " @ " + format_price(entry_p) + " | SL: " + format_price(sl_p) + " | TP1: " + format_price(tp1_p) + " | TP: " + format_price(tp_p) + " | R:" + str.tostring(rr_ratio) + " | Score:" + str.tostring(entry_score) + " | Risk:$" + str.tostring(risk_actual, "#.#")
        alert(short_msg, alert.freq_once_per_bar_close)

        strategy.entry("Short", strategy.short, qty=target_qty, alert_message=short_msg)
        if use_partial
            strategy.exit("TP1-Short", "Short", qty=qty1, stop=sl_p, limit=tp1_p, alert_message="TP1 Short " + syminfo.ticker)
            strategy.exit("TP2-Short", "Short", stop=sl_p, limit=tp_p, alert_message="TP2 Short " + syminfo.ticker)
        else
            strategy.exit("XR-Short", "Short", stop=sl_p, limit=tp_p, alert_message="Close Short " + syminfo.ticker)

        label.new(bar_index, high + atr_m15, text="SELL A+\nScore " + str.tostring(entry_score) + "\nSL " + format_price(sl_p) + "\nTP1 " + format_price(tp1_p) + "\nTP " + format_price(tp_p) + "\nRisk $" + str.tostring(risk_actual, "#.#"),
                  style=label.style_label_down, color=color.new(#f23645, 0), textcolor=color.white, size=size.small)

        if show_boxes
            sl_box := box.new(left=bar_index, top=sl_p, right=bar_index + 1, bottom=entry_p, bgcolor=color.new(color.red, 80), border_color=color.new(color.red, 50))
            tp1_box := box.new(left=bar_index, top=entry_p, right=bar_index + 1, bottom=tp1_p, bgcolor=color.new(#089981, 70), border_color=color.new(#089981, 50))
            tp_box := box.new(left=bar_index, top=tp1_p, right=bar_index + 1, bottom=tp_p, bgcolor=color.new(#089981, 85), border_color=color.new(#089981, 50))
        if show_sweep_lines and not na(armed_bear_extreme)
            sweep_ln := line.new(bar_index, armed_bear_extreme, bar_index + 20, armed_bear_extreme, color=color.new(#f23645, 20), width=2)
    else
        wait_entry_bear := false

// --- Manage open trades: TP1 detect → BE on runner ---
if strategy.position_size > 0 and use_partial
    if not tp1_hit and not na(tp1_p) and high >= tp1_p
        tp1_hit := true
        if use_be
            sl_p := entry_p + (atr_m15 * be_offset_atr)
            if not na(sl_box)
                box.set_bottom(sl_box, sl_p)
    strategy.exit("TP1-Long", "Long", qty=qty1, stop=sl_p, limit=tp1_p)
    strategy.exit("TP2-Long", "Long", stop=sl_p, limit=tp_p)

if strategy.position_size < 0 and use_partial
    if not tp1_hit and not na(tp1_p) and low <= tp1_p
        tp1_hit := true
        if use_be
            sl_p := entry_p - (atr_m15 * be_offset_atr)
            if not na(sl_box)
                box.set_top(sl_box, sl_p)
    strategy.exit("TP1-Short", "Short", qty=qty1, stop=sl_p, limit=tp1_p)
    strategy.exit("TP2-Short", "Short", stop=sl_p, limit=tp_p)

if strategy.position_size > 0 and not use_partial and not na(sl_p) and not na(tp_p)
    strategy.exit("XR-Long", "Long", stop=sl_p, limit=tp_p)
if strategy.position_size < 0 and not use_partial and not na(sl_p) and not na(tp_p)
    strategy.exit("XR-Short", "Short", stop=sl_p, limit=tp_p)

// Extend boxes while in trade
if strategy.position_size != 0
    if not na(sl_box)
        box.set_right(sl_box, bar_index)
    if not na(tp_box)
        box.set_right(tp_box, bar_index)
    if not na(tp1_box)
        box.set_right(tp1_box, bar_index)

// ============================ ALERT CONDITIONS ============================
alertcondition(buy_signal, title="A+ Long", message="XAUUSD M15 Sweep+MSS LONG")
alertcondition(sell_signal, title="A+ Short", message="XAUUSD M15 Sweep+MSS SHORT")

// ============================ DASHBOARD ============================
var table dash = table.new(position.bottom_right, 2, 9, bgcolor=color.new(color.black, 70), border_color=color.new(color.gray, 60), border_width=1, frame_color=color.new(color.gray, 60), frame_width=1)

if show_dashboard and barstate.islast
    float risk_usd = account_equity * (risk_pct / 100.0)
    float win_rate = strategy.closedtrades > 0 ? (strategy.wintrades / strategy.closedtrades) * 100.0 : 0.0
    string bias_txt = htf_bull and htf_bear ? "Neutral" : htf_bull ? "Bullish" : htf_bear ? "Bearish" : "Flat"
    string day_status = daily_ok ? "OK" : "HALTED"
    color day_col = daily_ok ? color.new(#089981, 0) : color.new(#f23645, 0)

    table.cell(dash, 0, 0, "M15 Sweep+MSS", text_color=color.white, text_size=size.small, text_halign=text.align_left, bgcolor=color.new(color.blue, 60))
    table.cell(dash, 1, 0, "A+", text_color=color.white, text_size=size.small, text_halign=text.align_right, bgcolor=color.new(color.blue, 60))

    table.cell(dash, 0, 1, "H4 Bias", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 1, bias_txt, text_color=color.white, text_size=size.small, text_halign=text.align_right)

    table.cell(dash, 0, 2, "Risk / Trade", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 2, "$" + str.tostring(risk_usd, "#.#") + " (" + str.tostring(risk_pct) + "%)", text_color=color.white, text_size=size.small, text_halign=text.align_right)

    table.cell(dash, 0, 3, "RR / TP1", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 3, "1:" + str.tostring(rr_ratio) + (use_partial ? " / " + str.tostring(tp1_ratio) + "R" : ""), text_color=color.white, text_size=size.small, text_halign=text.align_right)

    table.cell(dash, 0, 4, "Daily P&L", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 4, "$" + str.tostring(daily_pnl, "#.##"), text_color=daily_pnl >= 0 ? color.new(#089981, 0) : color.new(#f23645, 0), text_size=size.small, text_halign=text.align_right)

    table.cell(dash, 0, 5, "Day Status", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 5, day_status + " (" + str.tostring(daily_trade_count) + "/" + str.tostring(max_trades_day) + ")", text_color=day_col, text_size=size.small, text_halign=text.align_right)

    table.cell(dash, 0, 6, "Trades / WR", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 6, str.tostring(strategy.closedtrades) + " / " + str.tostring(win_rate, "#.#") + "%", text_color=color.white, text_size=size.small, text_halign=text.align_right)

    table.cell(dash, 0, 7, "Net Profit", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 7, "$" + str.tostring(strategy.netprofit, "#.##"), text_color=strategy.netprofit >= 0 ? color.new(#089981, 0) : color.new(#f23645, 0), text_size=size.small, text_halign=text.align_right)

    table.cell(dash, 0, 8, "Killzone", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 8, in_killzone ? (in_london ? "London" : in_ny ? "NY" : "On") : "Off", text_color=in_killzone ? color.new(#089981, 0) : color.new(#f23645, 0), text_size=size.small, text_halign=text.align_right)
